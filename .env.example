# Скопируй этот файл в .env и раскомментируй нужные строки.
# Настоящее окружение всегда важнее этого файла.
#
# Сам .env — в .gitignore, потому что в нём пароль. Пароль, попавший
# в историю git, считается утёкшим навсегда: он остаётся в старых
# коммитах даже после правки файла.

# ---------- база ----------
#
# Пока DATABASE_URL не задан, проект работает на sqlite во временном
# файле: всё запускается без установки. С PostgreSQL заказы и остатки
# остаются на месте.
#
# Поднять базу:  docker compose up -d db
# Схема:         python main.py migrate
# Каталог:       python main.py seed

# DATABASE_URL=postgresql://shop:shop@localhost:5432/shop

# ---------- запуск ----------

# Порт витрины. По умолчанию 8080.
# Хостинги обычно назначают порт сами переменной PORT — она читается
# тоже, но SHOP_PORT главнее.
# SHOP_PORT=3000

# ---------- только для публичного размещения ----------
#
# На своей машине эти переменные не нужны: в Dockerfile и render.yaml
# они уже выставлены. Здесь — чтобы было видно, что вообще есть.

# Наполнить базу каталогом при старте, ЕСЛИ она пуста.
# Непустую базу не трогает: иначе перезапуск сервиса стирал бы
# заказы и отзывы посетителей.
# SHOP_AUTO_SEED=1

# Демо-режим: раз в полчаса возвращать распроданные остатки,
# чтобы публичная витрина не превратилась в список «нет в наличии».
# SHOP_DEMO=1

# Читать адрес клиента из заголовков прокси. Включать ТОЛЬКО если
# сервис действительно стоит за обратным прокси: заголовок ставит
# кто угодно, и без прокси это дыра в ограничителе частоты.
# SHOP_TRUST_PROXY=1

# Сколько СВОИХ прокси перед сервисом. Адрес клиента берётся справа
# по этому счётчику: прокси дописывают себя в конец, а присланное
# клиентом остаётся слева, и доверять ему нельзя.
# SHOP_PROXY_HOPS=1

# Заголовок периметра, который тот перезаписывает, а не дописывает
# (у Cloudflare — CF-Connecting-IP). Надёжнее разбора цепочки.
# SHOP_CLIENT_IP_HEADER=CF-Connecting-IP

# Выключить ограничение частоты. Нужно для локальной отладки
# и нагрузочных прогонов, в остальных случаях трогать не надо.
# SHOP_RATE_LIMIT=0
