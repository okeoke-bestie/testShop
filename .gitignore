# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Окружения
.venv/
venv/
env/

# Базы данных: файл базы — не исходный код. Он у каждого свой,
# и коммит чужого файла означает конфликт при каждом слиянии.
*.db
shop.sqlite3
shop.sqlite3*

# Настройки с паролями. Самая дорогая строка в этом файле:
# пароль, попавший в историю git, считается утёкшим навсегда —
# он остаётся в старых коммитах даже после правки файла.
.env
.env.*
!.env.example

# Редакторы и ОС
.idea/
.vscode/
.DS_Store
Thumbs.db
